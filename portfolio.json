  "Confidence Definitions": [
    {
      "Term": "Estimate",
      "Meaning": "The original cost projection Javier produced before construction began, the industry term for the pre-construction budget projection",
      "When It Applies": "Before a project crosses into the operational workflow, before a Budget exists"
    },
    {
      "Term": "Budget",
      "Meaning": "The Schedule of Values amount approved once the loan is in place and construction begins, this becomes the figure the bank's draw schedule is measured against",
      "When It Applies": "Once a project is under construction"
    },
    {
      "Term": "Confirmed",
      "Meaning": "The actual cost figure is backed by a document BTZL has fully verified, an invoice, a signed lien waiver, a bank statement line",
      "When It Applies": "Applied to any Actual to Date figure"
    },
    {
      "Term": "Pending Confirmation",
      "Meaning": "The actual cost figure is based on an order, a pattern, or a partial document, with final confirmation still pending",
      "When It Applies": "Applied to any Actual to Date figure"
    },
    {
      "Term": "Flagged",
      "Meaning": "Something about this figure doesn't add up or conflicts with another document, requiring a confirmation request before it can be trusted",
      "When It Applies": "Applied to any Actual to Date figure"
    },
    {
      "Term": "Missing",
      "Meaning": "A cost is known to exist but no supporting document has arrived yet",
      "When It Applies": "Applied to any Actual to Date figure"
    }
  ],
